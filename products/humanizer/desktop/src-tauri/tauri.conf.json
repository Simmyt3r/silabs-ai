{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silabs Humanizer",
  "version": "0.2.0",
  "identifier": "com.silabs.humanizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Silabs Humanizer",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 650,
        "backgroundColor": "#0B1220"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none';"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
